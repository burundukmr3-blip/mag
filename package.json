{
  "name": "svoya-igra",
  "private": true,
  "version": "1.0.0",
  "description": "«Своя игра» — веб-приложение для проведения игры на общем экране",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview --open",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
